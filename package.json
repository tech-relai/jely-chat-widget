{
    "name": "@jely/chat-widget",
    "version": "0.1.5",
    "license": "MIT",
    "description": "Embeddable web-chat widget for Jely \u2014 anonymous visitor chat with an optional handoff to WhatsApp. React 18+ / Next.js.",
    "keywords": [
        "jely",
        "chat",
        "widget",
        "support",
        "whatsapp",
        "react",
        "nextjs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "typecheck:smoke": "tsc --noEmit -p smoke/tsconfig.json",
        "smoke:api": "node smoke/mock-api.mjs",
        "smoke:dev": "vite --config smoke/vite.config.ts",
        "smoke": "vite build --config smoke/vite.config.ts && vite preview --config smoke/vite.config.ts",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,json,md}\"",
        "prepublishOnly": "npm run typecheck && npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "dependencies": {
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "prettier": "^3.3.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.6.3",
        "vite": "^7.3.2",
        "vite-plugin-dts": "^4.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    }
}
