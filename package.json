{
    "name": "@jely/chat-widget",
    "version": "0.3.0",
    "license": "MIT",
    "description": "Embeddable web-chat widget for Jely — anonymous visitor chat with an optional handoff to WhatsApp. React 18+ / Next.js.",
    "keywords": [
        "jely",
        "chat",
        "widget",
        "support",
        "whatsapp",
        "react",
        "nextjs"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        },
        "./headless": {
            "import": {
                "types": "./dist/headless.d.ts",
                "default": "./dist/headless.js"
            },
            "require": {
                "types": "./dist/headless.d.cts",
                "default": "./dist/headless.cjs"
            },
            "default": "./dist/headless.js"
        },
        "./react": {
            "import": {
                "types": "./dist/react.d.ts",
                "default": "./dist/react.js"
            },
            "require": {
                "types": "./dist/react.d.cts",
                "default": "./dist/react.cjs"
            },
            "default": "./dist/react.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "typecheck:smoke": "tsc --noEmit -p smoke/tsconfig.json",
        "smoke:api": "node smoke/mock-api.mjs",
        "smoke:dev": "vite --config smoke/vite.config.ts",
        "smoke": "vite build --config smoke/vite.config.ts && vite preview --config smoke/vite.config.ts",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,json,md}\"",
        "prepublishOnly": "npm run typecheck && npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "dependencies": {
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "prettier": "^3.3.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.6.3",
        "vite": "^7.3.2",
        "vite-plugin-dts": "^4.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    }
}
